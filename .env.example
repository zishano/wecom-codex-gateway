# Enterprise WeChat transport: bot (recommended, no public URL) or callback
WECOM_TRANSPORT=bot

# Enterprise WeChat intelligent bot long connection
WECOM_BOT_ID=replace-with-bot-id
WECOM_BOT_SECRET=replace-with-bot-secret

# Enterprise WeChat self-built application callback (callback mode only)
WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx
WECOM_AGENT_ID=1000002
WECOM_APP_SECRET=replace-with-application-secret
WECOM_CALLBACK_TOKEN=replace-with-callback-token
WECOM_CALLBACK_AES_KEY=replace-with-43-character-encoding-aes-key

# Use * only while the intelligent bot visibility is restricted to yourself.
# Otherwise list permitted Enterprise WeChat user IDs separated by commas.
WECOM_ALLOWED_USERS=your_wecom_user_id

# Codex uses the login already configured on this machine.
CODEX_BIN=codex
CODEX_CWD=/mnt/e/Project/LMK
CODEX_MODEL=
CODEX_SANDBOX=workspace-write
CODEX_TIMEOUT_SECONDS=900

# Gateway
STATE_DB=./data/gateway.db
HOST=127.0.0.1
PORT=8787
PROGRESS_DELAY_SECONDS=8
MAX_WECOM_MESSAGE_BYTES=1800

# Local development only. Never enable these on a public deployment.
MOCK_WECOM=false
MOCK_CODEX=false
DEV_API_TOKEN=replace-with-a-long-random-value
